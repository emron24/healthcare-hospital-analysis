# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/
.mypy_cache/

# Data and Artifacts (Exclude raw/large files)
/data/raw/
/data/processed/*.csv
/data/processed/*.parquet
/data/processed/*.pkl
/data/processed/*.joblib
/data/processed/*.feather

# Tools/OS
.DS_Store
Thumbs.db

# Power BI Files (The .pbix file itself can be large; commit screenshots/docs instead)
/powerbi/*.pbix
/powerbi/.temp/

# Excel files (often binary and un-diffable)
/excel/*.xlsx

# Models and Logs
*.model
*.log